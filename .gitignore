# Build trees
/build/
/build-*/
/cmake-build-*/

# Generated, and never committed
#
# src/generated/ is written by steammock_codegen at build time, and
# gen/steam_interfaces.json is written by tools/steamworks_sdk_import.py from the
# SDKs the builder has. Both carry Valve's own API surface - the second one is
# Valve's interface layouts and the first is rendered from them - so neither
# belongs in the tree. gen/steam_api.idl.json, the hand-written seed, is the input
# and stays.
/src/generated/
/gen/steam_interfaces.json

# CMake in-tree artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
*.ninja

# MSVC
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.obj
*.tlog
*.lastbuildstate
*.vcxproj
*.vcxproj.filters
*.sln
.vs/

# Editors
.vscode/
.idea/
*.suo
*.user

# Agent scratch: transient session state written next to the checkout
.reasonix/

# A virtualenv for tools/steamworks_sdk_import.py, which is the only thing here
# that needs one
.venv/

# Runtime output from the harness
*.jsonl
