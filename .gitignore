# Build trees
/build/
/build-*/
/cmake-build-*/

# Generated, and never committed
#
# src/generated/ is written by steammock_codegen at build time, and gen/ holds the
# two things tools/steamworks_sdk_import.py reads out of the SDKs the builder has:
# the flat API surface the stub exports, and the interface layouts it hands out.
# All three carry Valve's own API - one rendered from the other two - so none of
# them belongs in the tree.
/src/generated/
/gen/steam_api_surface.json
/gen/steam_interfaces.json

# CMake in-tree artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
*.ninja

# MSVC
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.obj
*.tlog
*.lastbuildstate
*.vcxproj
*.vcxproj.filters
*.sln
.vs/

# Editors
.vscode/
.idea/
*.suo
*.user

# Agent scratch: transient session state written next to the checkout
.reasonix/

# A virtualenv for tools/steamworks_sdk_import.py, which is the only thing here
# that needs one
.venv/
__pycache__/

# Runtime output from the harness
*.jsonl
