{
  "note_lines": [
    "A worked example: two games, two profiles. Match rules pick a profile from the",
    "executable name, so two games running at once each get their own identity, stats",
    "and achievements.",
    "",
    "'scripted' is for the calls that decide whether a game believes Steam is present.",
    "Everything the harness can derive from state (identity, language, app id, stats,",
    "achievements) is answered without being listed here.",
    "",
    "No ownership, entitlement or licensing call appears in this file, by design."
  ],
  "profiles": {
    "default": {
      "app_id": 480,
      "steam_id": 76561198000000001,
      "persona_name": "DebugPlayer",
      "language": "english",
      "ui_language": "english",
      "install_path": "C:\\Program Files (x86)\\Steam",
      "build_id": 4242,
      "stats": {
        "Deaths": 0,
        "PlaytimeMinutes": 42
      },
      "achievements": [
        { "name": "ACH_BOOTED", "achieved": false },
        { "name": "ACH_FINISHED", "achieved": false }
      ],
      "scripted": {
        "SteamAPI_Init": { "ret": true },
        "SteamAPI_IsSteamRunning": { "ret": true },
        "SteamAPI_RestartAppIfNecessary": { "ret": false },
        "SteamAPI_ISteamUser": { "ret": 4660 },
        "SteamAPI_ISteamUtils": { "ret": 4661 },
